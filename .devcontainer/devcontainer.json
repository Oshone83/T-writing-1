{
  // GitHub Codespaces / dev container for this repo. Node 22, dependencies installed for the Stripe experiment.
  "name": "T-writing-1",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "cd stripe-webhooks-vs-polling && npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Stripe webhook receiver", "onAutoForward": "silent" }
  }
}
