{
  "name": "stripe-polling-vs-webhooks",
  "version": "1.0.0",
  "description": "Companion repo: I replaced payment polling with webhooks, then killed the endpoint",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20.6" },
  "scripts": {
    "receiver": "node --env-file=.env receiver.js",
    "poll": "node --env-file=.env poll.js",
