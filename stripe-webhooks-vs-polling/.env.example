# cp .env.example .env   — these values work as-is with the local fake Stripe (npm run fake-stripe).
# They are made-up simulation values, not real credentials.
STRIPE_SECRET_KEY=sk_test_local_simulation_key
STRIPE_WEBHOOK_SECRET=whsec_local_simulation_secret
STRIPE_API_BASE=http://127.0.0.1:12111

# Optional
# PORT=3000                              receiver port
# FAKE_STRIPE_RETRY_SECONDS=10,30,60     the fake's webhook retry schedule (then it gives up)
# DB_PATH=payments.db

# To use real Stripe in TEST mode instead (optional, see README):
#   STRIPE_SECRET_KEY=sk_test_…      your test-mode secret key (scripts refuse live keys)
#   STRIPE_WEBHOOK_SECRET=whsec_…    printed by `stripe listen`
#   delete the STRIPE_API_BASE line
