# Copy to .env (git-ignored) only if you are NOT using Codespaces secrets / ./exp set-api-key.
# TEST MODE ONLY: the scripts refuse sk_live_/rk_live_ keys and these placeholders.

# Dashboard (Test mode) → Developers → API keys. A restricted key (rk_test_) with
# PaymentIntents: Write and Events: Read is safest; a secret key (sk_test_) also works.
STRIPE_SECRET_KEY=sk_test_replace_me

# Dashboard → Workbench → Webhooks → your event destination → Reveal secret. Starts with whsec_.
# Easier: ./exp set-webhook-secret (paste with input hidden).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=.            where payments.db, logs/, run/, results/ live
# STRIPE_HTTP_CLIENT=fetch   only behind an HTTPS proxy; run node with NODE_USE_ENV_PROXY=1 too
