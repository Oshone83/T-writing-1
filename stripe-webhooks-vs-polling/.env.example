# Copy to .env (which is git-ignored) and fill in. TEST MODE ONLY: the scripts refuse sk_live_ keys.

# Dashboard → Developers → API keys, with "Test mode" switched on. Starts with sk_test_.
# A restricted key (rk_test_) also works if it can write PaymentIntents and read PaymentIntents + Events.
STRIPE_SECRET_KEY=sk_test_replace_me

# Dashboard → Developers → Webhooks → your endpoint → "Signing secret". Starts with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional
# PORT=3000
# DB_PATH=./payments.db
